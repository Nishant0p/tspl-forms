// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  HR
  MANAGER
  EMPLOYEE
  FORM_VIEWER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FormAccessMode {
  PUBLIC
  AUTHENTICATED
  RESTRICTED
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  description String    @default("")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees           Employee[]
  allowedFormAccesses FormAllowedDepartment[]

  @@index([active])
}

model Branch {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  location    String    @default("")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees           Employee[]
  allowedFormAccesses FormAllowedBranch[]

  @@index([active])
}

model Employee {
  id          Int            @id @default(autoincrement())
  clerkUserId String         @unique
  employeeId  String         @unique
  firstName   String
  lastName    String
  email       String
  password    String?
  phone       String?
  departmentId Int?
  branchId    Int?
  managerId   Int?
  role        EmployeeRole   @default(EMPLOYEE)
  status      EmployeeStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  manager     Employee?   @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  directReports Employee[] @relation("EmployeeManager")
  responses    FormSubmissions[]
  allowedForms FormAllowedEmployee[]
  formViewerAccesses FormViewerAccess[]
  formRequestsRaised   FormRequest[] @relation("RequestedBy")
  formRequestsAssigned FormRequest[] @relation("AssignedTo")

  @@index([clerkUserId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([branchId])
  @@index([managerId])
}

model Form {
  id          Int      @id @default(autoincrement())
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  published   Boolean  @default(false)
  status      FormStatus @default(DRAFT)
  name        String
  description String   @default("")
  content     String   @db.Text
  accessMode  FormAccessMode @default(PUBLIC)
  loginRequired Boolean @default(false)
  oneResponsePerUser Boolean @default(false)
  startDate   DateTime?
  endDate     DateTime?
  responseLimit Int?

  visits      Int @default(0)
  submissions Int @default(0)

  shareUrl       String           @unique @default(uuid())
  FormSubmissions FormSubmissions[]
  allowedRoles    FormAllowedRole[]
  allowedDepartments FormAllowedDepartment[]
  allowedBranches FormAllowedBranch[]
  allowedEmployees FormAllowedEmployee[]
  formViewerAccesses FormViewerAccess[]

  @@unique([userId, name])
  @@index([status])
  @@index([accessMode])
}

model FormSubmissions {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  submittedAt DateTime @default(now())
  formId    Int
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  clerkUserId String?

  content String @db.Text

  @@unique([formId, employeeId])
  @@index([formId])
  @@index([employeeId])
  @@index([clerkUserId])
}

model FormAllowedRole {
  id        Int          @id @default(autoincrement())
  formId    Int
  role      EmployeeRole
  createdAt DateTime     @default(now())

  form      Form         @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([formId, role])
  @@index([role])
}

model FormAllowedDepartment {
  id           Int         @id @default(autoincrement())
  formId       Int
  departmentId Int
  createdAt    DateTime    @default(now())

  form         Form        @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([formId, departmentId])
  @@index([departmentId])
}

model FormAllowedBranch {
  id         Int       @id @default(autoincrement())
  formId     Int
  branchId   Int
  createdAt  DateTime  @default(now())

  form       Form      @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([formId, branchId])
  @@index([branchId])
}

model FormAllowedEmployee {
  id         Int       @id @default(autoincrement())
  formId     Int
  employeeId Int
  createdAt  DateTime  @default(now())

  form       Form      @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([formId, employeeId])
  @@index([employeeId])
}

model FormViewerAccess {
  id         Int       @id @default(autoincrement())
  formId     Int
  employeeId Int
  createdAt  DateTime  @default(now())

  form       Form      @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([formId, employeeId])
  @@index([employeeId])
  @@index([formId])
}

enum FormRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model FormRequest {
  id              Int               @id @default(autoincrement())
  title           String
  description     String            @db.Text
  formType        String            @default("Other")
  priority        String            @default("NORMAL")
  status          FormRequestStatus @default(PENDING)
  requestedById   Int
  assignedToId    Int?
  completedFormId Int?
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  requestedBy     Employee          @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  assignedTo      Employee?         @relation("AssignedTo",  fields: [assignedToId],  references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([assignedToId])
  @@index([status])
}


