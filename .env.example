# Self-Hosted VPS PostgreSQL Database Configuration
# Replace user, password, host, port, and database name with your VPS details
DATABASE_URL="postgresql://postgres:password@localhost:5432/tspl_forms?schema=public"

# Super Admin Identity Provider (IDP) Configuration
SUPER_ADMIN_IDP="EMP000"
SUPER_ADMIN_EMAIL="admin@tspl.group"
SUPER_ADMIN_PASSWORD="YourSecurePasswordHere"
SUPER_ADMIN_ROUTE="/super-admin"

# Custom Domain Configuration
NEXT_PUBLIC_APP_URL="https://forms.tsplgroup.in"